# .env.example
# Copy this file to .env and fill in the values required to run Dagster locally.

# Dagster instance home (defaults to dagster_home/ in the project root)
DAGSTER_HOME=D:/Github/tennis-match-prediction/dagster_home

# Path to the consolidated TennisMyLife ATP CSV. Defaults to data/raw/historical_matches/all_atp_matches.csv
TENNIS_RAW_MATCHES_CSV=

# Data directory root. Defaults to ./data if not set.
TENNIS_DATA_DIR=

# Start with: docker compose -f compose.mlflow.yaml up -d --build --wait
TENNIS_MLFLOW_MODE=server
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=tennis-match-prediction
MLFLOW_PORT=5000
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow-local
MLFLOW_POSTGRES_DB=mlflow
# Optional explicit local tracking root (used with --tracking-mode local).
TENNIS_MLFLOW_LOCAL_DIR=
